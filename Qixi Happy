<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  body {
    background: radial-gradient(ellipse at center, #0a0a18 0%, #020208 100%);
    overflow: hidden;
    font-family: 'STSong','SimSun','Songti SC','KaiTi',serif;
    cursor: default;
    user-select: none; -webkit-user-select: none;
    height: 100vh; width: 100vw;
  }
  canvas { display:block; position:fixed; top:0; left:0; }
  .overlay {
    position:fixed; top:0; left:0; right:0; bottom:0;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    pointer-events:none; z-index:10;
  }
  .title {
    font-size:clamp(2.5rem,7vw,5rem); font-weight:bold;
    background:linear-gradient(135deg,#ff4088,#e040fb,#ff80ab,#ea80fc,#ff4088);
    background-size:400% 400%;
    -webkit-background-clip:text; background-clip:text;
    -webkit-text-fill-color:transparent;
    animation:gradientShift 4s ease-in-out infinite;
    letter-spacing:0.2em;
    filter:drop-shadow(0 0 50px rgba(255,64,136,0.6)) drop-shadow(0 0 100px rgba(224,64,251,0.4));
